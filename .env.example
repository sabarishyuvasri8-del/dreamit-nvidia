# ==========================================
# DREAM-IT ENVIRONMENT CONFIGURATION (NVIDIA AI)
# ==========================================

# Server-Side Only Keys (Used by /api/ai-chat serverless functions & local dev proxy)
# NEVER prefix with VITE_ so they are NEVER exposed in the client-side JavaScript bundle
NVIDIA_API_KEY="your_nvidia_api_key_here"
GROQ_API_KEY=

# Client-Side Public Keys (Safe to be bundled in browser)
VITE_NVIDIA_API_KEY="your_nvidia_api_key_here"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
VITE_CADENCE_API_URL="http://localhost:8000"
VITE_VAPID_PUBLIC_KEY="your_vapid_public_key"

# Server-Side Push Notification VAPID Keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:support@dreamit.app"
